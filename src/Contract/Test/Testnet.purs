-- NOTE: We use `Int64.top` (i64::MAX = 9223372036854775807) here instead of
-- `BigNum.maxValue` (u64::MAX = 18446744073709551615) for the ex-unit fields.
--
-- Plutus execution budgets are backed by `SatInt`, a saturating 64-bit
-- *signed* integer (see `CostingInteger`, `ExCPU`, and `ExMemory`):
-- https://github.com/IntersectMBO/plutus/blob/9dbffb2f3be9622316a6b1fadccdcb3d0e37952d/plutus-core/plutus-core/src/PlutusCore/Evaluation/Machine/ExMemory.hs#L72
--
-- `BigNum.maxValue` is roughly 2x `SatInt`'s upper bound. Setting ex units to
-- `BigNum.maxValue` causes Ogmios to 500 with an uncaught exception.
-- `Int64.top` is the largest value that stays within `SatInt`'s range and
-- reliably avoids this failure.
testnetConfigWithMaxExUnits :: TestnetConfig
testnetConfigWithMaxExUnits =
  defaultTestnetConfig
    { clusterConfig =
        defaultTestnetConfig.clusterConfig
          { pparams =
              defaultTestnetConfig.clusterConfig.pparams
                { max_tx_ex_mem = maxVal
                , max_tx_ex_steps = maxVal
                , max_block_ex_mem = maxVal
                , max_block_ex_steps = maxVal
                }
          }
    }
  where
  maxVal = Just $ Stringed $ BigNum.fromStringUnsafe $ Int64.toString top

defaultTestnetClusterConfig :: TestnetClusterConfig
defaultTestnetClusterConfig =
  { testnetMagic: 2
  , slotLength: Seconds 0.1
  , epochSize: Nothing
  , pparams: defaultTestnetProtocolParameters
  }

